# Python's local .env is the sole runtime source for Xunfei ASR/TTS credentials.
# Java configuration files are neither read nor required. Basic registration,
# login and non-provider APIs work without these optional provider credentials.
AI_MEETING_XUNFEI_TTS_APP_ID=
AI_MEETING_XUNFEI_TTS_API_KEY=
AI_MEETING_XUNFEI_TTS_API_SECRET=
AI_MEETING_XUNFEI_ASR_APP_ID=
AI_MEETING_XUNFEI_ASR_API_KEY=
AI_MEETING_XUNFEI_ASR_API_SECRET=
